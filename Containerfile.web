# OpenCode Container for Cloud Run
# Builds frontend + backend into a single container
#
# Build: docker build -f Dockerfile.cloudrun -t opencode:latest .
# Run:   docker run -p 8080:8080 -e PORT=8080 opencode:latest

# =============================================================================
# Stage 1: Install dependencies
# =============================================================================
# Use bun 1.3+ as required by the build script
FROM oven/bun:1.3-alpine AS deps

# Install jq for JSON manipulation and git for the build script
RUN apk add --no-cache jq git

WORKDIR /app

# Copy workspace config, lockfile, and patches
COPY package.json bun.lock ./
COPY patches/ ./patches/
COPY packages/app/package.json ./packages/app/
COPY packages/ui/package.json ./packages/ui/
COPY packages/sdk/js/package.json ./packages/sdk/js/
COPY packages/plugin/package.json ./packages/plugin/
COPY packages/util/package.json ./packages/util/
COPY packages/opencode/package.json ./packages/opencode/
COPY packages/script/package.json ./packages/script/

# Filter package.json to only include workspaces that are actually copied
# This prevents "workspace not found" errors for packages like slack, console, etc.
RUN jq '.workspaces.packages = ["packages/app", "packages/ui", "packages/sdk/js", "packages/plugin", "packages/util", "packages/opencode", "packages/script"]' package.json > package.filtered.json \
    && mv package.filtered.json package.json

# Install all dependencies
# Note: Cannot use --frozen-lockfile since we modified workspaces above
RUN bun install

# Verify @opentui packages are installed (they're required for the build)
RUN ls /app/node_modules/@opentui/ 2>/dev/null || \
    (echo "Installing missing @opentui packages..." && \
     cd /app/packages/opencode && bun install)

# =============================================================================
# Stage 2: Build frontend
# =============================================================================
FROM deps AS frontend-builder

# Copy frontend source
COPY packages/app ./packages/app
COPY packages/ui ./packages/ui
COPY packages/sdk ./packages/sdk
COPY packages/util ./packages/util
COPY tsconfig.json ./

# Build the frontend
RUN cd packages/app && bun run build

# =============================================================================
# Stage 3: Build backend (opencode binary)
# =============================================================================
FROM deps AS backend-builder

# Copy backend source
COPY packages/opencode ./packages/opencode
COPY packages/plugin ./packages/plugin
COPY packages/util ./packages/util
COPY packages/sdk ./packages/sdk
COPY packages/script ./packages/script
COPY tsconfig.json ./

# Remove any local node_modules that got copied (broken symlinks in container)
# Run bun install in opencode package to ensure all deps are linked properly
RUN rm -rf /app/packages/opencode/node_modules && \
    cd /app/packages/opencode && bun install

# Build opencode binary for current platform
# Set OPENCODE_CHANNEL to avoid git branch lookup (no .git in container)
RUN cd packages/opencode && OPENCODE_CHANNEL=latest bun run build --single --skip-install

# =============================================================================
# Stage 4: Runtime
# =============================================================================
FROM alpine:3.20

# Install runtime dependencies
RUN apk add --no-cache libgcc libstdc++ ripgrep ca-certificates

# Copy built opencode binary
# Note: The build script creates platform-specific directories
COPY --from=backend-builder /app/packages/opencode/dist/opencode-linux-*/bin/opencode /usr/local/bin/opencode

# Copy built frontend
COPY --from=frontend-builder /app/packages/app/dist /opt/frontend

# Verify binary works
RUN opencode --version

# Environment variables
ENV OPENCODE_STATIC_DIR=/opt/frontend
ENV PORT=8080

# Expose port (Cloud Run uses $PORT)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://localhost:${PORT}/global/health || exit 1

# Run opencode server
# Use shell form to allow $PORT expansion
CMD opencode serve --hostname 0.0.0.0 --port ${PORT}
